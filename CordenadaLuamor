-- 4. LÓGICA DOS BOTÕES

-- Botão 1: Salvar Coordenada do Personagem
btnSalvar.MouseButton1Click:Connect(function()
	local character = player.Character
	if character and character:FindFirstChild("HumanoidRootPart") then
		local pos = character.HumanoidRootPart.Position
		-- Salva com arredondamento de 2 casas decimais
		coordenadaSalva = Vector3.new(
			math.floor(pos.X * 100) / 100,
			math.floor(pos.Y * 100) / 100,
			math.floor(pos.Z * 100) / 100
		)
		outputBox.Text = string.format("X: %.2f, Y: %.2f, Z: %.2f", coordenadaSalva.X, coordenadaSalva.Y, coordenadaSalva.Z)
	else
		outputBox.Text = "Personagem não encontrado!"
	end
end)

-- Botão 2: Excluir
btnExcluir.MouseButton1Click:Connect(function()
	coordenadaSalva = nil
	outputBox.Text = "Coordenada excluída"
end)

-- Botão 3: Mostrar Código de Cordenada (Vector3 ou Teleport)
btnMostrar.MouseButton1Click:Connect(function()
	if coordenadaSalva then
		local codigo = string.format("Vector3.new(%.2f, %.2f, %.2f)", coordenadaSalva.X, coordenadaSalva.Y, coordenadaSalva.Z)
		outputBox.Text = codigo
	else
		outputBox.Text = "Salve uma coordenada primeiro!"
	end
end)

